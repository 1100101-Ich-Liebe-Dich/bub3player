{
  "id": "synthwave",
  "order": 3,
  "name": "Synthwave",
  "tagline": "Neon-Raster bis zum Horizont, Retro-Sonne, Scanlines. Das Gitter rast im Takt.",
  "qml": "qrc:/qml/skins/Synthwave.qml",
  "fonts": { "ui": "Chakra Petch", "display": "Orbitron", "mono": "Chakra Petch" },
  "radius": 2,
  "ambient": 0.0,
  "dynamicAccent": false,
  "swatch": ["#12002A", "#FF2BD6", "#22F0FF"],
  "style": { "titleSize": 34, "titleUpper": true, "titleSpacing": 3, "titleWeight": 900, "chamfer": 14 },
  "palettes": [
    { "id": "outrun", "name": "Outrun", "dark": true,
      "colors": { "bg": "#0B0019", "panel": "#120025", "surface": "#1A0636", "surfaceHover": "#2A0B52",
                  "border": "#4A1A6E", "text": "#FDF0FF", "textDim": "#D6A6E8", "textFaint": "#8C62A6",
                  "accent": "#FF2BD6", "accent2": "#22F0FF", "onAccent": "#1A0013" },
      "sky": ["#05001A", "#3B0A6B", "#B0186E", "#FF7A3D"], "sun": ["#FFE45C", "#FF2E88"] },
    { "id": "sunset", "name": "Sonnenbrand", "dark": true,
      "colors": { "bg": "#120208", "panel": "#1C0510", "surface": "#2A0918", "surfaceHover": "#401026",
                  "border": "#5A1E1A", "text": "#FFF1E6", "textDim": "#F0B49A", "textFaint": "#A2685A",
                  "accent": "#FF6A2B", "accent2": "#FFD23D", "onAccent": "#1E0700" },
      "sky": ["#0B0005", "#4A0820", "#C2241E", "#FFB13D"], "sun": ["#FFF27A", "#FF4A1C"] },
    { "id": "matrix", "name": "Matrix", "dark": true,
      "colors": { "bg": "#000A04", "panel": "#001207", "surface": "#00190B", "surfaceHover": "#002A14",
                  "border": "#0E4A26", "text": "#E6FFEF", "textDim": "#8FE0B0", "textFaint": "#3F8A5C",
                  "accent": "#2BFF88", "accent2": "#B6FF3B", "onAccent": "#001A0A" },
      "sky": ["#000302", "#00170A", "#003B1C", "#0B7A3E"], "sun": ["#D6FF7A", "#16C76A"] },
    { "id": "ice", "name": "Eiszeit", "dark": true,
      "colors": { "bg": "#00081A", "panel": "#03102A", "surface": "#061A3D", "surfaceHover": "#0B2A5C",
                  "border": "#16406E", "text": "#EEF9FF", "textDim": "#A5CDE8", "textFaint": "#5A7FA0",
                  "accent": "#5BD8FF", "accent2": "#B48CFF", "onAccent": "#001022" },
      "sky": ["#00010A", "#071A45", "#1A4C8F", "#8FD3FF"], "sun": ["#FFFFFF", "#7AB8FF"] }
  ],
  "settings": [
    { "key": "palette", "type": "palette", "label": "Farbwelt", "default": "outrun" },
    { "key": "gridSpeed", "type": "range", "label": "Tempo des Gitters", "min": 0.0, "max": 3.0, "step": 0.1, "default": 1.0, "unit": "×" },
    { "key": "beat", "type": "range", "label": "Puls im Takt", "min": 0.0, "max": 1.0, "step": 0.05, "default": 0.7, "percent": true },
    { "key": "scanlines", "type": "range", "label": "Scanlines", "min": 0.0, "max": 1.0, "step": 0.05, "default": 0.45, "percent": true },
    { "key": "sun", "type": "bool", "label": "Retro-Sonne", "default": true },
    { "key": "stars", "type": "bool", "label": "Sterne", "default": true },
    { "key": "mountains", "type": "bool", "label": "Berge am Horizont", "default": true },
    { "key": "glitch", "type": "bool", "label": "Glitch beim Titelwechsel", "default": true },
    { "key": "glow", "type": "bool", "label": "Neon-Leuchten", "default": true },
    { "key": "fps", "type": "choice", "label": "Animation", "default": "60",
      "options": [ { "value": "60", "label": "Flüssig" }, { "value": "30", "label": "Sparsam" }, { "value": "0", "label": "Aus" } ] }
  ]
}
