{
  "id": "tower",
  "order": 7,
  "name": "Hi-Fi Turm",
  "tagline": "90er-Minianlage: Leuchtdisplay mit Spektrum, CD-Wechsler, Doppel-Kassettendeck. Großansicht mit Boxen vor einem Oszilloskop, das der Musik folgt.",
  "qml": "qrc:/qml/skins/Tower.qml",
