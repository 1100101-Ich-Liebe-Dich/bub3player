    {
      "key": "mode",
      "type": "choice",
      "label": "Displayanzeige (Taste DISPLAY)",
      "default": "0",
      "options": [
        {
          "value": "0",
          "label": "Titel, Zeit und Spektrum"
        },
        {
          "value": "1",
          "label": "Großes Spektrum"
        },
        {
          "value": "2",
          "label": "Uhr"
        }
      ]
    },
    {
      "key": "demo",
